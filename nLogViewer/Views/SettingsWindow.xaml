<Window x:Class="nLogViewer.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
        mc:Ignorable="d" 
        Title="Настройки приложения" 
        Height="500" Width="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Icon="../Infrastructure/Resources/Images/256px/log.png">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Основное содержимое -->
        <TabControl Grid.Row="0" Margin="10">
            
            <!-- Вкладка "Производительность" -->
            <TabItem Header="Производительность">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10">
                    <StackPanel>
                        
                        <!-- Заголовок секции -->
                        <TextBlock Text="Настройки виртуализации UI" 
                                   FontSize="16" FontWeight="Bold" 
                                   Margin="0,0,0,15"/>
                        
                        <!-- Виртуализация строк -->
                        <GroupBox Header="Виртуализация строк" Margin="0,0,0,15">
                            <StackPanel Margin="10">
                                <CheckBox x:Name="EnableRowVirtualizationCheckBox"
                                          IsChecked="{Binding EnableRowVirtualization}" 
                                          Margin="0,0,0,10">
                                    <TextBlock TextWrapping="Wrap">
                                        <Run Text="Включить виртуализацию строк" FontWeight="Bold"/>
                                        <LineBreak/>
                                        <Run Text="Рекомендуется для больших логов (>1000 записей). Может некорректно работать с многострочным текстом." 
                                             FontStyle="Italic" Foreground="Gray"/>
                                    </TextBlock>
                                </CheckBox>
                                
                                <CheckBox IsChecked="{Binding EnablePanelVirtualization}" 
                                          IsEnabled="{Binding EnableRowVirtualization}"
                                          Margin="20,0,0,10">
                                    <TextBlock TextWrapping="Wrap">
                                        <Run Text="Включить виртуализацию панели"/>
                                        <LineBreak/>
                                        <Run Text="Дополнительная оптимизация для очень больших списков" 
                                             FontStyle="Italic" Foreground="Gray"/>
                                    </TextBlock>
                                </CheckBox>
                                
                                <CheckBox IsChecked="{Binding EnableCanContentScroll}" 
                                          IsEnabled="{Binding EnableRowVirtualization}"
                                          Margin="20,0,0,15">
                                    <TextBlock TextWrapping="Wrap">
                                        <Run Text="Включить скролл по содержимому"/>
                                        <LineBreak/>
                                        <Run Text="Более быстрый скролл, но может быть неточным для элементов разной высоты" 
                                             FontStyle="Italic" Foreground="Gray"/>
                                    </TextBlock>
                                </CheckBox>
                                
                                <!-- Режим виртуализации -->
                                <StackPanel Orientation="Horizontal" Margin="20,0,0,10"
                                            IsEnabled="{Binding EnableRowVirtualization}">
                                    <TextBlock Text="Режим виртуализации:" VerticalAlignment="Center" Width="150"/>
                                    <ComboBox ItemsSource="{Binding VirtualizationModes}"
                                              SelectedItem="{Binding VirtualizationMode}"
                                              Width="120"/>
                                </StackPanel>
                                
                                <TextBlock TextWrapping="Wrap" Margin="20,0,0,0" Foreground="Gray" FontStyle="Italic">
                                    Recycling - переиспользует элементы (быстрее, но может глючить)
                                    <LineBreak/>
                                    Standard - создаёт новые элементы (стабильнее, но медленнее)
                                </TextBlock>
                            </StackPanel>
                        </GroupBox>
                        
                        <!-- Автоматическая виртуализация -->
                        <GroupBox Header="Автоматические настройки" Margin="0,0,0,15">
                            <StackPanel Margin="10">
                                <CheckBox IsChecked="{Binding AutoVirtualization}" 
                                          Margin="0,0,0,10">
                                    <TextBlock TextWrapping="Wrap">
                                        <Run Text="Автоматическая виртуализация" FontWeight="Bold"/>
                                        <LineBreak/>
                                        <Run Text="Автоматически включать/отключать виртуализацию в зависимости от количества записей" 
                                             FontStyle="Italic" Foreground="Gray"/>
                                    </TextBlock>
                                </CheckBox>
                                
                                <StackPanel Orientation="Horizontal" Margin="20,0,0,10"
                                            IsEnabled="{Binding AutoVirtualization}">
                                    <TextBlock Text="Порог (записей):" VerticalAlignment="Center" Width="150"/>
                                    <TextBox Text="{Binding MaxItemsWithoutVirtualization}" 
                                             Width="80" TextAlignment="Right"/>
                                </StackPanel>
                                
                                <TextBlock TextWrapping="Wrap" Margin="20,0,0,0" Foreground="Gray" FontStyle="Italic">
                                    При превышении указанного количества записей виртуализация включится автоматически
                                </TextBlock>
                            </StackPanel>
                        </GroupBox>
                        
                        <!-- Информация -->
                        <Border Background="LightYellow" BorderBrush="Orange" BorderThickness="1" 
                                Padding="10" Margin="0,10,0,0">
                            <TextBlock TextWrapping="Wrap">
                                <Run Text="ℹ️ Рекомендации:" FontWeight="Bold"/>
                                <LineBreak/>
                                • Для многострочных логов отключите виртуализацию
                                <LineBreak/>
                                • Для больших файлов (>10k записей) включите виртуализацию
                                <LineBreak/>
                                • При проблемах со скроллом попробуйте режим "Standard"
                            </TextBlock>
                        </Border>
                        
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            
            <!-- Вкладка "Память" (пока пустая, для будущего расширения) -->
            <TabItem Header="Память">
                <ScrollViewer Padding="10">
                    <TextBlock Text="Настройки управления памятью будут добавлены в будущих версиях" 
                               Foreground="Gray" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </ScrollViewer>
            </TabItem>
            
        </TabControl>
        
        <!-- Кнопки -->
        <Border Grid.Row="1" Background="LightGray" Padding="10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="По умолчанию" 
                        Command="{Binding ResetToDefaultCommand}"
                        Width="100" Height="30" 
                        Margin="0,0,10,0"/>
                <Button Content="Отмена" 
                        Command="{Binding CancelCommand}"
                        Width="80" Height="30" 
                        Margin="0,0,10,0"/>
                <Button Content="Сохранить" 
                        Command="{Binding SaveCommand}"
                        Width="80" Height="30"
                        IsDefault="True"/>
            </StackPanel>
        </Border>
        
    </Grid>
</Window>