<Window x:Class="nLogViewer.Tester.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:nLogViewer.Tester"
        xmlns:model="clr-namespace:nLogViewer.Model;assembly=nLogViewer"
        mc:Ignorable="d"
        DataContext="{Binding MainWindowViewModel, Source={StaticResource Locator}}"
        Title="{Binding Title}" 
        SizeToContent="Height" 
        Width="400">
    <Grid Margin="10,0">
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <GroupBox Grid.Row="0" Header="Генерация одиночных сообщений" Margin="0,5">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Grid.Resources>
                    <Style TargetType="Button">
                        <Setter Property="Margin" Value="5"/>
                    </Style>
                </Grid.Resources>
                <Button Grid.Column="0" Command="{Binding GenEvent}" 
                        CommandParameter="{x:Static model:LogEntryType.Trace}"
                        ToolTip="Генерация одиночного события с важностью &quot;Trace&quot;">
                    <Image Source="../../Infrastructure/Resources/Images/Medium/Trace.png"/>
                </Button>
                <Button Grid.Column="1" Command="{Binding GenEvent}" 
                        CommandParameter="{x:Static model:LogEntryType.Debug}"
                        ToolTip="Генерация одиночного события с важностью &quot;Debug&quot;">
                    <Image Source="../../Infrastructure/Resources/Images/Medium/Debug.png"/>
                </Button>
                <Button Grid.Column="2" Command="{Binding GenEvent}" 
                        CommandParameter="{x:Static model:LogEntryType.Info}"
                        ToolTip="Генерация одиночного события с важностью &quot;Info&quot;">
                    <Image Source="../../Infrastructure/Resources/Images/Medium/Info.png"/>
                </Button>
                <Button Grid.Column="3" Command="{Binding GenEvent}" 
                        CommandParameter="{x:Static model:LogEntryType.Warn}"
                        ToolTip="Генерация одиночного события с важностью &quot;Warn&quot;">
                    <Image Source="../../Infrastructure/Resources/Images/Medium/Warning.png"/>
                </Button>
                <Button Grid.Column="4" Command="{Binding GenEvent}" 
                        CommandParameter="{x:Static model:LogEntryType.Error}"
                        ToolTip="Генерация одиночного события с важностью &quot;Error&quot;">
                    <Image Source="../../Infrastructure/Resources/Images/Medium/Error.png"/>
                </Button>
                <Button Grid.Column="5" Command="{Binding GenEvent}" 
                        CommandParameter="{x:Static model:LogEntryType.Fatal}"
                        ToolTip="Генерация одиночного события с важностью &quot;Error&quot;">
                    <Image Source="../../Infrastructure/Resources/Images/Medium/Fatal.png"/>
                </Button>
            </Grid>
        </GroupBox>
        <GroupBox Grid.Row="1" Header="Генерация пачки сообщений (рандомная важность)" Margin="0,5">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Grid.Resources>
                        <Style TargetType="Button">
                            <Setter Property="Margin" Value="5"/>
                            <Setter Property="MinHeight" Value="40"/>
                        </Style>
                    </Grid.Resources>
                    <Button Grid.Column="0" Content="10" Command="{Binding GenRandom}"
                            CommandParameter="10"/>
                    <Button Grid.Column="1" Content="100" Command="{Binding GenRandom}"
                            CommandParameter="100"/>
                    <Button Grid.Column="2" Content="1_000" Command="{Binding GenRandom}"
                            CommandParameter="1000"/>
                    <Button Grid.Column="3" Content="10_000" Command="{Binding GenRandom}"
                            CommandParameter="10000"/>
                    <Button Grid.Column="4" Content="100_000" Command="{Binding GenRandom}"
                            CommandParameter="100000"/>
                </Grid>
            </GroupBox>
        <TextBlock Grid.Row="2" Text="{Binding LogCount, StringFormat=Всего сообщений {0}}" />
    </Grid>
</Window>
